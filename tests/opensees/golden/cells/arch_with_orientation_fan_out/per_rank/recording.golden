=== model.tcl ===
# auto-generated by apeGmsh.opensees; do not edit by hand
# apeGmsh <VERSION>; backend stock
model BasicBuilder -ndm 3 -ndf 6
timeSeries Linear 1
timeSeries Linear 2
geomTransf Linear 1 0.9659258262890683 0.0 0.2588190451025207
geomTransf Linear 2 0.7071067811865476 0.0 0.7071067811865475
geomTransf Linear 3 0.2588190451025208 0.0 0.9659258262890682
if {[info commands getPID] == ""} { proc getPID {} { return 0 } }
if {[getPID] == 0} { source [file join [file dirname [info script]] ranks rank0_0.tcl] }

if {[getPID] == 1} { source [file join [file dirname [info script]] ranks rank1_0.tcl] }

recorder Node -file out/node_disp.out -node 4 -dof 1 2 disp
recorder Element -file out/ele_force.out -ele 2 3 4 globalForce
recorder mpco out/run.mpco -N displacement -E force -R 1
# === Stage: gravity ===
domainChange
constraints Plain
numberer ParallelRCM
system Mumps -matrixType 0
test NormDispIncr 1e-06 10 0 2
algorithm Newton
integrator LoadControl 0.5
analysis Static
if {[getPID] == 1} { source [file join [file dirname [info script]] ranks rank1_1.tcl] }

for {set _apesees_i 0} {$_apesees_i < 2} {incr _apesees_i} {
    if {[analyze 1] != 0} {
        error "apeGmsh: analyze FAILED at increment [expr {$_apesees_i + 1}]/2 of stage 'gravity' (pseudo-time [getTime]) -- aborting, the remaining deck would run on a partial state"
    }
    if {[expr {($_apesees_i + 1) % 1}] == 0 || [expr {$_apesees_i + 1}] == 2} {
        puts "APEGMSH_PROGRESS i=[expr {$_apesees_i + 1}] n=2 t=[getTime]"
        flush stdout
    }
}
loadConst -time 0.0
wipeAnalysis
# === Stage: push ===
domainChange
constraints Plain
numberer ParallelRCM
system Mumps -matrixType 0
test NormDispIncr 1e-06 10 0 2
algorithm Newton
integrator LoadControl 0.5
analysis Static
if {[getPID] == 1} { source [file join [file dirname [info script]] ranks rank1_2.tcl] }

for {set _apesees_i 0} {$_apesees_i < 1} {incr _apesees_i} {
    if {[analyze 1] != 0} {
        error "apeGmsh: analyze FAILED at increment [expr {$_apesees_i + 1}]/1 of stage 'push' (pseudo-time [getTime]) -- aborting, the remaining deck would run on a partial state"
    }
    if {[expr {($_apesees_i + 1) % 1}] == 0 || [expr {$_apesees_i + 1}] == 1} {
        puts "APEGMSH_PROGRESS i=[expr {$_apesees_i + 1}] n=1 t=[getTime]"
        flush stdout
    }
}
loadConst -time 0.0
wipeAnalysis
