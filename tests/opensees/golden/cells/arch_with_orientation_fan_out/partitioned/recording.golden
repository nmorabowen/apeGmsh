if {[info commands getPID] == ""} { proc getPID {} { return 0 } }
if {[getPID] == 0} {
    node 1 1.0 0.0 0.0
    node 2 0.8660254037844387 0.0 0.49999999999999994
    node 3 0.5000000000000001 0.0 0.8660254037844386
    element elasticBeamColumn 2 1 2 0.01 200000000000.0 80000000000.0 0.0001 0.0001 0.0001 1
    element elasticBeamColumn 3 2 3 0.01 200000000000.0 80000000000.0 0.0001 0.0001 0.0001 2
    fix 1 1 1 1 1 1 1
    region 1 -ele 2 3
}

if {[getPID] == 1} {
    node 3 0.5000000000000001 0.0 0.8660254037844386
    node 4 0.0 0.0 1.0
