=== model.tcl ===
# auto-generated by apeGmsh.opensees; do not edit by hand
model BasicBuilder -ndm 2 -ndf 2
uniaxialMaterial Elastic 1 100.0
timeSeries Linear 1
timeSeries Linear 2
if {[info commands getPID] == ""} { proc getPID {} { return 0 } }
if {[getPID] == 0} {
    node 1 0.0 0.0
    node 2 1.0 0.0
    node 3 2.0 0.0
    node 4 3.0 0.0
    node 5 4.0 0.0
    element Truss 2 1 2 1.0 1
    element Truss 3 2 3 1.0 1
    element Truss 4 3 4 1.0 1
    element Truss 5 4 5 1.0 1
    fix 1 1 1
    fix 2 0 1
    fix 3 0 1
    fix 4 0 1
    fix 5 0 1
    region 1 -node 2 3 4 5 -ele 2 3 4 5
}

if {[getPID] == 1} {
    node 5 4.0 0.0
    node 6 5.0 0.0
    node 7 6.0 0.0
    node 8 7.0 0.0
    node 9 8.0 0.0
    element Truss 6 5 6 1.0 1
    element Truss 7 6 7 1.0 1
    element Truss 8 7 8 1.0 1
    element Truss 9 8 9 1.0 1
    fix 5 0 1
    fix 6 0 1
    fix 7 0 1
    fix 8 0 1
    fix 9 0 1
    region 1 -node 5 6 7 8 9 -ele 6 7 8 9
}

recorder Node -file out/node_disp.out -node 2 3 4 5 6 7 8 9 -dof 1 2 disp
recorder Element -file out/ele_force.out -ele 2 3 4 5 6 7 8 9 globalForce
recorder mpco out/run.mpco -N displacement -E force -R 1
# === Stage: gravity ===
domainChange
constraints Plain
numberer ParallelRCM
system Mumps -matrixType 0
test NormDispIncr 1e-06 10 0 2
algorithm Newton
integrator LoadControl 0.5
analysis Static
if {[getPID] == 0} {
    pattern Plain 1 1 {
        load 2 10.0 0.0
        load 3 10.0 0.0
        load 4 10.0 0.0
        load 5 10.0 0.0
    }
}

if {[getPID] == 1} {
    pattern Plain 1 1 {
        load 6 10.0 0.0
        load 7 10.0 0.0
        load 8 10.0 0.0
        load 9 10.0 0.0
    }
}

for {set _apesees_i 0} {$_apesees_i < 2} {incr _apesees_i} {
    if {[analyze 1] != 0} {
        error "apeGmsh: analyze FAILED at increment [expr {$_apesees_i + 1}]/2 of stage 'gravity' (pseudo-time [getTime]) -- aborting, the remaining deck would run on a partial state"
    }
    if {[expr {($_apesees_i + 1) % 1}] == 0 || [expr {$_apesees_i + 1}] == 2} {
        puts "APEGMSH_PROGRESS i=[expr {$_apesees_i + 1}] n=2 t=[getTime]"
        flush stdout
    }
}
loadConst -time 0.0
wipeAnalysis
# === Stage: push ===
domainChange
constraints Plain
numberer ParallelRCM
system Mumps -matrixType 0
test NormDispIncr 1e-06 10 0 2
algorithm Newton
integrator LoadControl 0.5
analysis Static
if {[getPID] == 0} {
    pattern Plain 2 2 {
        load 2 -5.0 0.0
        load 3 -5.0 0.0
        load 4 -5.0 0.0
        load 5 -5.0 0.0
    }
}

if {[getPID] == 1} {
    pattern Plain 2 2 {
        load 6 -5.0 0.0
        load 7 -5.0 0.0
        load 8 -5.0 0.0
        load 9 -5.0 0.0
    }
}

for {set _apesees_i 0} {$_apesees_i < 1} {incr _apesees_i} {
    if {[analyze 1] != 0} {
        error "apeGmsh: analyze FAILED at increment [expr {$_apesees_i + 1}]/1 of stage 'push' (pseudo-time [getTime]) -- aborting, the remaining deck would run on a partial state"
    }
    if {[expr {($_apesees_i + 1) % 1}] == 0 || [expr {$_apesees_i + 1}] == 1} {
        puts "APEGMSH_PROGRESS i=[expr {$_apesees_i + 1}] n=1 t=[getTime]"
        flush stdout
    }
}
loadConst -time 0.0
wipeAnalysis
