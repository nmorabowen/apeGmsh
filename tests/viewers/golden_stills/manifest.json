{
  "about": "X2-a oracle (#1662): what the director path (ResultsDirector) renders today. Read by tests/viewers/test_x2_golden_stills.py. PNGs are block-averaged by tolerance.downsample from window-sized frames. Regenerate only from CI's renderer.",
  "fixture": {"lx": 4.0, "ly": 1.0, "n": [9, 3], "n_steps": 5, "stage": "push", "kind": "static"},
  "theme": "catppuccin_mocha",
  "window": [640, 360],
