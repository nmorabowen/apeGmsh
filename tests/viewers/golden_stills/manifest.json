  "tolerance": {"downsample": 4, "max_delta": 48, "bad_delta": 16, "max_bad_fraction": 0.01},
  "render": {
    "mesh": {"component": null, "step": -1, "golden": "render_mesh.png"},
    "contour": {"component": "displacement_y", "step": -1, "golden": "render_contour.png"},
    "deformed": {"component": "displacement_y", "step": -1, "golden": "render_deformed.png"},
    "reactions": {"component": "reactions", "step": -1, "golden": "render_reactions.png"}
  },
  "render_pack": {
    "files": ["mesh.png", "contour.png", "deformed.png", "reactions.png", "history.png"],
    "count": 5,
    "stills": {
      "mesh.png": "pack_mesh.png",
      "contour.png": "pack_contour.png",
      "deformed.png": "pack_deformed.png",
      "reactions.png": "pack_reactions.png"
    }
  },
  "animation": {
    "component": "displacement_y",
    "fps": 10,
    "step_stride": 3,
    "frame_steps": [0, 3, 4],
    "frame_count": 3,
    "first": "anim_first.png",
    "last": "anim_last.png"
  },
  "assess_figures": ["mesh.png", "contour.png", "deformed.png", "reactions.png", "history.png"]
