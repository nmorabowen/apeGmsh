{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://apegmsh.local/studio/highlight.schema.json",
  "title": "HighlightRequest",
  "type": "object",
  "required": ["schema", "names", "dimtags"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "names": { "type": "array", "items": { "type": "string" } },
    "dimtags": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "integer" },
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "additionalProperties": true
}
