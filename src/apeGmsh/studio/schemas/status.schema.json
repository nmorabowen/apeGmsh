{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://apegmsh.local/studio/status.schema.json",
  "title": "StudioStatus",
  "type": "object",
  "required": ["schema", "contract_version", "root"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "contract_version": { "type": "string" },
    "root": { "type": "string" },
    "names": { "type": ["object", "null"] },
    "names_error": { "type": ["string", "null"] },
    "last_run": { "type": ["object", "null"] },
    "n_runs": { "type": "integer" },
    "last_pin": { "type": ["object", "null"] },
    "n_pins": { "type": "integer" },
    "selection": { "type": ["object", "null"] },
    "selection_error": { "type": ["string", "null"] },
    "ledger_error": { "type": ["string", "null"] },
    "empty": { "type": "boolean" },
    "ok": { "type": "boolean" },
    "error": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
