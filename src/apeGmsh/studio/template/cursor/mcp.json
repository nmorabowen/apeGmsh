{
  "mcpServers": {
    "apegmsh-studio-habitat": {
      "command": "__APEGMSH_PYTHON__",
      "args": [
        "-m",
        "apeGmsh.studio.mcp"
      ],
      "env": {
        "LADRUNO_OPENSEES_QUIET": "1",
        "APEGMSH_QUIET": "1",
        "APEGMSH_STUDIO_ROOT": "__HABITAT_ROOT__",
        "PYTHONPATH": "__APEGMSH_SRC__"
      }
    }
  }
}
